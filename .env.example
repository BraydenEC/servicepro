# ServicePro — environment variables
#
# Copy this file to `.env.local` and fill in the two values below.
# `.env.local` is gitignored and must NEVER be committed.
#
# Where to find these:
#   1. Go to https://supabase.com/dashboard and open your project
#   2. Project Settings (gear icon, bottom left) → API
#   3. Copy the two values described below
#
# Both are prefixed NEXT_PUBLIC_ because they are read in the browser.
# That is safe ONLY because the anon key is designed to be public and the
# `projects` table is protected by a read-only RLS policy. Never put the
# `service_role` key in a NEXT_PUBLIC_ variable — it bypasses RLS entirely.

# "Project URL" — looks like https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Project API keys" → the `anon` / `public` key (a long JWT starting with ey...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Week 1 — generative core (/core)
# ---------------------------------------------------------------------------
#
# Get a key at https://console.anthropic.com → API Keys.
#
# NOTE: no NEXT_PUBLIC_ prefix. This key is read only by server-side code
# (lib/core/extract.ts, imported solely by a Route Handler), so Next.js never
# inlines it into client JavaScript. Adding NEXT_PUBLIC_ would ship your
# billable API key to every visitor's browser.
#
# Optional. With this unset the /core page still works — it falls back to a
# deterministic pattern-matching extractor and says so in the response.

ANTHROPIC_API_KEY=
